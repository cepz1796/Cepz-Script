-- ========== MAIN LOOP ==========
task.spawn(function()
    local tc = 0
    while task.wait(0.15) do
        tc = tc + 1
        local c = C.ch
        if not c or not c.Parent then continue end
        local hp, hm = C.hp, C.hm
        if not hp or not hm then continue end

        if math.abs(hm.WalkSpeed - C.speed) > 0.5 then
            hm.WalkSpeed = C.speed
        end

        if C.autoTreadmill and tc % 3 == 0 then
            local tr = findR({"treadmill","train","run"})
            if tr then safeFire(tr) end
        end

        if C.autoSteal and tc % 2 == 0 then
            local egg = findEgg(false)
            if egg then
                local ep
                if egg:IsA("BasePart") then ep = egg.Position
                elseif egg:IsA("Model") and egg.PrimaryPart then ep = egg.PrimaryPart.Position end
                if ep then
                    local dd = (hp.Position - ep).Magnitude
                    if dd > 8 then
                        hm:MoveTo(ep)
                        if dd > 250 then hp.CFrame = CFrame.new(ep + Vector3.new(0, 5, 0)) end
                    else
                        local sr = findR({"steal","grab","take","egg","pick"})
                        if sr then safeFire(sr, egg) end
                        if C.autoReturn and C.basePos then
                            task.wait(0.25)
                            hp.CFrame = CFrame.new(C.basePos + Vector3.new(0, 5, 0))
                        end
                    end
                end
            end
        end

        if C.autoRare and tc % 2 == 1 then
            local re = findEgg(true)
            if re then
                local ep
                if re:IsA("BasePart") then ep = re.Position
                elseif re:IsA("Model") and re.PrimaryPart then ep = re.PrimaryPart.Position end
                if ep then
                    local dd = (hp.Position - ep).Magnitude
                    if dd > 10 then
                        if not C.fl then startFly() end
                        if C.fv then C.fv.Velocity = (ep - hp.Position).Unit * C.flySpeed end
                    else
                        stopFly()
                        local sr = findR({"steal","grab","take","egg","pick"})
                        if sr then safeFire(sr, re) end
                        if C.autoReturn and C.basePos then
                            task.wait(0.25)
                            hp.CFrame = CFrame.new(C.basePos + Vector3.new(0, 5, 0))
                        end
                    end
                end
            elseif C.fl then
                stopFly()
            end
        end
    end
end)

