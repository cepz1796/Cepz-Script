-- ========== ANTI GUARD ==========
local GKW = {"guard","guardian","penjaga","enemy","monster","boss","hunter","chaser","seeker","protector","watcher","keeper","sentinel","police","cop"}

local function isG(m)
    if not m or not m:IsA("Model") then return false end
    local n = m.Name:lower()
    for _, k in ipairs(GKW) do if n:find(k) then return true end end
    if m:FindFirstChildOfClass("Humanoid") and m ~= C.ch then
        if not Players:GetPlayerFromCharacter(m) then
            if m:GetAttribute("IsGuard") then return true end
        end
    end
    return false
end

local function frz(m)
    local h = m:FindFirstChildOfClass("Humanoid")
    if h then
        h.WalkSpeed = 0
        h.JumpPower = 0
        h.JumpHeight = 0
        h.AutoRotate = false
        h.PlatformStand = true
        pcall(function()
            h:ChangeState(Enum.HumanoidStateType.Physics)
        end)
    end
    local hp = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
    if hp and not hp:FindFirstChild("_c1") then
        local bv = Instance.new("BodyVelocity", hp)
        bv.Name = "_c1"
        bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        bv.Velocity = Vector3.zero

        local bg = Instance.new("BodyGyro", hp)
        bg.Name = "_c2"
        bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
        bg.P = 100000
        bg.D = 1000
        bg.CFrame = hp.CFrame

        local bp = Instance.new("BodyPosition", hp)
        bp.Name = "_c3"
        bp.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        bp.Position = hp.Position
        bp.P = 100000
        bp.D = 1000
    end
    for _, p in pairs(m:GetDescendants()) do
        if p:IsA("BasePart") then
            p.CanCollide = false
            p.Anchored = true
        elseif p:IsA("Script") or p:IsA("LocalScript") then
            pcall(function() p.Disabled = true end)
        end
    end
    m:SetAttribute("_cF", true)
end

freezeGuards = function()
    for _, o in pairs(workspace:GetDescendants()) do
        if o:IsA("Model") and isG(o) and not o:GetAttribute("_cF") then
            pcall(frz, o)
        end
    end
end

unfreezeGuards = function()
    for _, o in pairs(workspace:GetDescendants()) do
        if o:IsA("Model") and o:GetAttribute("_cF") then
            local h = o:FindFirstChildOfClass("Humanoid")
            if h then
                h.WalkSpeed = 16
                h.JumpPower = 50
                h.PlatformStand = false
                h.AutoRotate = true
            end
            local hp = o:FindFirstChild("HumanoidRootPart") or o.PrimaryPart
            if hp then
                for _, n in ipairs({"_c1","_c2","_c3"}) do
                    local f = hp:FindFirstChild(n)
                    if f then f:Destroy() end
                end
            end
            for _, p in pairs(o:GetDescendants()) do
                if p:IsA("BasePart") then p.Anchored = false
                elseif p:IsA("Script") or p:IsA("LocalScript") then
                    pcall(function() p.Disabled = false end)
                end
            end
            o:SetAttribute("_cF", nil)
        end
    end
end

task.spawn(function()
