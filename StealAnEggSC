local function mkt(name, icon, y, fn)
    local b = Instance.new("TextButton", mf)
    b.Size = UDim2.new(1, -30, 0, 44)
    b.Position = UDim2.new(0, 15, 0, y)
    b.BackgroundColor3 = Color3.fromRGB(40, 40, 52)
    b.BorderSizePixel = 0
    b.Text = icon .. "  " .. name .. "  •  OFF"
    b.TextColor3 = Color3.fromRGB(190, 190, 200)
    b.TextSize = 12
    b.Font = Enum.Font.GothamSemibold
    b.TextXAlignment = Enum.TextXAlignment.Left
    b.Parent = mf

    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 10)

    local s = Instance.new("UIStroke", b)
    s.Color = Color3.fromRGB(60, 60, 75)
    s.Thickness = 1

    local st = false
    b.MouseButton1Click:Connect(function()
        st = not st
        b.Text = icon .. "  " .. name .. "  •  " .. (st and "ON" or "OFF")
        b.BackgroundColor3 = st and Color3.fromRGB(35, 90, 65) or Color3.fromRGB(40, 40, 52)
        b.TextColor3 = st and Color3.fromRGB(180, 255, 210) or Color3.fromRGB(190, 190, 200)
        s.Color = st and Color3.fromRGB(76, 175, 132) or Color3.fromRGB(60, 60, 75)
        pcall(fn, st)
    end)
end

