end)

-- ========== FLY ==========
local function startFly()
    if C.fl then return end
    local c = C.ch
    if not c or not c:FindFirstChild("HumanoidRootPart") then return end
    local hp = c.HumanoidRootPart

    C.fv = Instance.new("BodyVelocity", hp)
    C.fv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    C.fv.Velocity = Vector3.zero

    C.fg = Instance.new("BodyGyro", hp)
    C.fg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    C.fg.P = 1000
    C.fg.D = 50

    C.fl = true
    task.spawn(function()
        while C.fl do
            task.wait()
            local md = Vector3.zero
            if UIS:IsKeyDown(Enum.KeyCode.W) then md = md + CAM.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then md = md - CAM.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then md = md - CAM.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then md = md + CAM.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then md = md + Vector3.new(0, 1, 0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then md = md - Vector3.new(0, 1, 0) end
            if md.Magnitude > 0 then md = md.Unit * C.flySpeed end
            if C.fv then C.fv.Velocity = md end
            if C.fg then C.fg.CFrame = CAM.CFrame end
        end
    end)
end

local function stopFly()
    C.fl = false
    if C.fv then C.fv:Destroy(); C.fv = nil end
    if C.fg then C.fg:Destroy(); C.fg = nil end
end

-- ========== REMOTE ==========
local rcache = nil
local lastScan = 0

local function scanR()
    if rcache then return rcache end
    if tick() - lastScan < 5 then return nil end
    lastScan = tick()
    local l = {}
    for _, o in pairs(RS:GetDescendants()) do
        if o:IsA("RemoteEvent") or o:IsA("RemoteFunction") then
            table.insert(l, o)
        end
    end
    rcache = l
    return l
end

local function findR(kw)
    local l = scanR()
    if not l then return nil end
    for _, o in ipairs(l) do
        local n = o.Name:lower()
        for _, k in ipairs(kw) do
            if n:find(k) then return o end
        end
    end
    return nil
end

local lastFire = 0
local function safeFire(r, ...)
    if not r then return end
    local now = tick()
    if now - lastFire < 0.3 + math.random() * 0.3 then return end
    lastFire = now
    pcall(function()
        if r:IsA("RemoteEvent") then r:FireServer(...)
        elseif r:IsA("RemoteFunction") then r:InvokeServer(...) end
    end)
end

-- ========== RARE ==========
local RKW = {"secret","eternal","divine","legendary","mythic","cosmic","exclusive","limited","event"}

local function isRare(e)
    local n = e.Name:lower()
    for _, k in ipairs(RKW) do
        if n:find(k) then return true end
    end
    return false
end

local function findEgg(rareOnly)
    local best, dist = nil, math.huge
    local c = C.ch
    if not c or not c:FindFirstChild("HumanoidRootPart") then return nil end
    local hp = c.HumanoidRootPart

    for _, o in pairs(workspace:GetDescendants()) do
        if (o:IsA("BasePart") or o:IsA("Model")) and o.Name:lower():find("egg") then
            if rareOnly and not isRare(o) then continue end
            local p
            if o:IsA("BasePart") then p = o.Position
            elseif o:IsA("Model") and o.PrimaryPart then p = o.PrimaryPart.Position
            else continue end
            local d = (hp.Position - p).Magnitude
            if d < dist then
                dist = d
                best = o
            end
        end
    end
    return best
end

